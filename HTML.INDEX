<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <title>Sistema de Visitas – Limpeza</title>

  <!-- Firebase SDKs (CDN) -->
  <script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-app-compat.js"></script>
  <script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-firestore-compat.js"></script>
  <script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-storage-compat.js"></script>

  <!-- jsPDF (para gerar PDF da rota) -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>

  <style>
    /* ---------- ESTILO GERAL ---------- */
    *{margin:0;padding:0;box-sizing:border-box;font-family:"Segoe UI",Arial,sans-serif}
    body{background:#f4f5f7;color:#1f2937}
    nav{background:#1f2937;padding:16px 24px;display:flex;gap:24px}
    nav a{color:#f9fafb;text-decoration:none;font-weight:600}
    nav a:hover{color:#38bdf8}
    .container{max-width:960px;margin:32px auto;padding:0 16px}
    h1{margin-bottom:24px}
    .section{display:none}
    .active{display:block}
    .banner-alerta{background:#fee2e2;color:#991b1b;padding:14px 18px;border-radius:8px;margin-bottom:16px;font-weight:600}
    .sem-alertas{background:#dcfce7;color:#166534;padding:14px 18px;border-radius:8px}
    .item-alerta{background:#fff;border-left:4px solid #ef4444;padding:12px 16px;border-radius:6px;margin-bottom:10px;display:flex;flex-direction:column;gap:4px;box-shadow:0 1px 3px rgba(0,0,0,.08)}
    .form-box{background:#fff;padding:20px;border-radius:8px;box-shadow:0 1px 3px rgba(0,0,0,.08);margin-bottom:24px}
    input,select,textarea{width:100%;padding:10px;margin-bottom:12px;border:1px solid #d1d5db;border-radius:6px;font-size:14px}
    button{background:#2563eb;color:#fff;border:none;padding:10px 18px;border-radius:6px;cursor:pointer;font-weight:600}
    button:hover{background:#1d4ed8}
    .card-cliente,.devolutiva-item{background:#fff;padding:16px;border-radius:8px;margin-bottom:12px;box-shadow:0 1px 3px rgba(0,0,0,.08)}
    .card-cliente h3,.devolutiva-item strong{margin-bottom:6px}
    .info{font-size:13px;color:#6b7280;margin-bottom:8px}
    .produtos-lista{font-size:13px;margin:8px 0;padding-left:18px}
    .acoes button{font-size:13px;padding:6px 12px;margin-right:8px}
    .checkbox-cliente{display:flex;align-items:center;gap:10px;background:#fff;padding:10px 14px;border-radius:6px;margin-bottom:8px}
    .checkbox-cliente input{width:auto}
    .qr-code{margin-top:12px}
  </style>
</head>
<body>

  <!-- NAV -->
  <nav>
    <a href="#" data-target="dashboard">Dashboard</a>
    <a href="#" data-target="clientes">Clientes</a>
    <a href="#" data-target="rota">Montar Rota</a>
    <a href="#" data-target="devolutiva">Devolutiva</a>
  </nav>

  <div class="container">

    <!-- ---------- DASHBOARD ---------- -->
    <section id="dashboard" class="section active">
      <h1>Painel de Visitas</h1>
      <div id="alertas-container">Carregando alertas…</div>
    </section>

    <!-- ---------- CLIENTES ---------- -->
    <section id="clientes" class="section">
      <h1>Clientes & Produtos</h1>

      <!-- Cadastro de cliente -->
      <div class="form-box">
        <h3>Cadastrar novo cliente</h3>
        <input type="text" id="c-nome" placeholder="Nome do cliente">
        <input type="text" id="c-responsavel" placeholder="Responsável (vendedor)">
        <button id="c-btn">Cadastrar</button>
      </div>

      <!-- Lista de clientes -->
      <div id="lista-clientes">Carregando…</div>
    </section>

    <!-- ---------- ROTA ---------- -->
    <section id="rota" class="section">
      <h1>Montar Rota</h1>

      <div class="form-box">
        <input type="text" id="r-responsavel" placeholder="Nome do vendedor responsável">
      </div>

      <div id="lista-clientes-rota">Carregando clientes…</div>

      <button id="r-criar">Criar Rota + PDF</button>
    </section>

    <!-- ---------- DEVOLUTIVA ---------- -->
    <section id="devolutiva" class="section">
      <h1>Devolutiva da Rota</h1>

      <div class="form-box">
        <label for="select-rota">Selecione a rota pendente:</label>
        <select id="select-rota"></select>
      </div>

      <div id="clientes-devolutiva"></div>

      <button id="finalizar-rota" style="display:none;">Finalizar Rota</button>
    </section>

  </div>

  <!-- ---------- SCRIPT ---------- -->
  <script>
    /* ---------- NAVEGAÇÃO ---------- */
    document.querySelectorAll('nav a').forEach(a => {
      a.addEventListener('click', e => {
        e.preventDefault();
        const target = a.dataset.target;
        document.querySelectorAll('.section').forEach(s => s.classList.remove('active'));
        document.getElementById(target).classList.add('active');
      });
    });

    /* ---------- CONFIGURAÇÃO FIREBASE ---------- */
    const firebaseConfig = {
      apiKey: "SUA_API_KEY",
      authDomain: "SEU_PROJETO.firebaseapp.com",
      projectId: "SEU_PROJETO",
      storageBucket: "SEU_PROJETO.appspot.com",
      messagingSenderId: "SEU_SENDER_ID",
      appId: "SEU_APP_ID"
    };
    firebase.initializeApp(firebaseConfig);
    const db = firebase.firestore();
    const storage = firebase.storage();

    /* ---------- UTILIDADES ---------- */
    const DIAS_LIMITE = 30;

    /* ---------- DASHBOARD ---------- */
    async function carregarAlertas() {
      const snapshot = await db.collection('clientes').get();
      const hoje = new Date();
      const atrasados = [];

      snapshot.forEach(doc => {
        const data = doc.data();
        if (!data.ultimaVisita) {
          atrasados.push({id:doc.id, nome:data.nome, responsavel:data.responsavelNome, dias:null});
          return;
        }
        const diff = Math.floor((hoje - data.ultimaVisita.toDate())/(1000*60*60*24));
        if (diff > DIAS_LIMITE) {
          atrasados.push({id:doc.id, nome:data.nome, responsavel:data.responsavelNome, dias:diff});
        }
      });

      const container = document.getElementById('alertas-container');
      container.innerHTML = '';
      if (!atrasados.length) {
        container.innerHTML = '<p class="sem-alertas">Nenhum cliente atrasado.</p>';
        return;
      }
      const banner = document.createElement('div');
      banner.className = 'banner-alerta';
      banner.innerHTML = `⚠️ <strong>${atrasados.length}</strong> cliente(s) sem visita há mais de 30 dias`;
      container.appendChild(banner);
      atrasados.forEach(c => {
        const item = document.createElement('div');
        item.className = 'item-alerta';
        item.innerHTML = `
          <span class="nome-cliente">${c.nome}</span>
          <span class="dias-sem-visita">${c.dias ?? 'Nunca'} dias sem visita</span>
          <span class="responsavel">Responsável: ${c.responsavel || '—'}</span>
        `;
        container.appendChild(item);
      });
    }
    carregarAlertas();

    /* ---------- CLIENTES ---------- */
    async function listarClientes() {
      const container = document.getElementById('lista-clientes');
      container.innerHTML = 'Carregando…';
      const snap = await db.collection('clientes').orderBy('nome').get();
      if (snap.empty) {
        container.innerHTML = '<p>Nenhum cliente cadastrado.</p>';
        return;
      }
      container.innerHTML = '';
      snap.forEach(doc => {
        const c = doc.data();
        const ultima = c.ultimaVisita ? c.ultimaVisita.toDate().toLocaleDateString('pt-BR') : 'Nunca';
        const card = document.createElement('div');
        card.className = 'card-cliente';
        card.innerHTML = `
          <h3>${c.nome}</h3>
          <div class="info">Responsável: ${c.responsavelNome || '—'} | Última visita: ${ultima}</div>
          ${c.produtos?.length ? '<ul class="produtos-lista">' + c.produtos.map(p=>`<li>${p.nome} – ${p.cor} – ${p.quantEstoque} em estoque / ${p.quantGondola} na gôndola</li>`).join('') + '</ul>' : ''}
          <div class="acoes">
            <button onclick="abrirModalProduto('${doc.id}')">+ Produto</button>
            <button onclick="registrarVisita('${doc.id}')">Visita agora</button>
          </div>
        `;
        container.appendChild(card);
      });
    }

    // Cadastro de cliente
    document.getElementById('c-btn').addEventListener('click', async () => {
      const nome = document.getElementById('c-nome').value.trim();
      const resp = document.getElementById('c-responsavel').value.trim();
      if (!nome) { alert('Nome obrigatório'); return; }
      await db.collection('clientes').add({
        nome,
        responsavelNome: resp || '',
        ultimaVisita: null,
        produtos: [],
        criadoEm: firebase.firestore.FieldValue.serverTimestamp()
      });
      document.getElementById('c-nome').value = '';
      document.getElementById('c-responsavel').value = '';
      listarClientes();
    });

    // Registrar visita
    async function registrarVisita(id) {
      await db.collection('clientes').doc(id).update({
        ultimaVisita: firebase.firestore.FieldValue.serverTimestamp()
      });
      listarClientes();
      carregarAlertas();
    }

    /* ---------- MODAL PRODUTO ---------- */
    function abrirModalProduto(clienteId) {
      const modal = document.createElement('div');
      modal.style.position = 'fixed';
      modal.style.top = 0; modal.style.left = 0; modal.style.right = 0; modal.style.bottom = 0;
      modal.style.background = 'rgba(0,0,0,.5)';
      modal.style.display = 'flex';
      modal.style.alignItems = 'center';
      modal.style.justifyContent = 'center';
      modal.innerHTML = `
        <div class="form-box" style="width:400px;position:relative;">
          <h3>Adicionar Produto</h3>
          <select id="p-tipo">
            <option value="">Tipo (obrigatório)</option>
            <option>prata 925</option>
            <option>semijoia</option>
            <option>bijouteria</option>
            <option>óculos</option>
            <option>relógio</option>
            <option>aço inoxidável</option>
            <option>folheado</option>
            <option>bolsa</option>
          </select>
          <input type="text" id="p-nome" placeholder="Nome do produto">
          <input type="color" id="p-cor" placeholder="Cor (obrigatório)">
          <input type="number" id="p-estoque" placeholder="Qtde em estoque">
          <input type="number" id="p-gondola" placeholder="Qtde na gôndola">
          <input type="file" id="p-foto" accept="image/*">
          <button id="p-salvar">Salvar</button>
          <button id="p-cancelar" style="margin-left:8px;background:#6b7280;">Cancelar</button>
        </div>
      `;
      document.body.appendChild(modal);

      document.getElementById('p-cancelar').onclick = () => modal.remove();

      document.getElementById('p-salvar').onclick = async () => {
        const tipo = document.getElementById('p-tipo').value;
        const nome = document.getElementById('p-nome').value.trim();
        const cor = document.getElementById('p-cor').value;
        const estoque = Number(document.getElementById('p-estoque').value) || 0;
        const gondola = Number(document.getElementById('p-gondola').value) || 0;
        const fotoFile = document.getElementById('p-foto').files[0];

        if (!tipo) { alert('Selecione o tipo do produto'); return; }
        if (!cor) { alert('Informe a cor'); return; }

        let fotoURL = '';
        if (fotoFile) {
          const storageRef = storage.ref().child(`produtos/${clienteId}/${Date.now()}_${fotoFile.name}`);
          await storageRef.put(fotoFile);
          fotoURL = await storageRef.getDownloadURL();
        }

        const novoProd = {
          tipo,
          nome,
          cor,
          quantEstoque: estoque,
          quantGondola: gondola,
          fotoURL,
          criadoEm: firebase.firestore.FieldValue.serverTimestamp()
        };

        const clienteRef = db.collection('clientes').doc(clienteId);
        await clienteRef.update({
          produtos: firebase.firestore.FieldValue.arrayUnion(novoProd)
        });

        modal.remove();
        listarClientes(); // atualização imediata
      };
    }

    /* ---------- ROTA ---------- */
    async function listarClientesRota() {
      const container = document.getElementById('lista-clientes-rota');
      container.innerHTML = 'Carregando…';
      const snap = await db.collection('clientes').orderBy('nome').get();
      container.innerHTML = '';
      snap.forEach(doc => {
        const c = doc.data();
        const div = document.createElement('div');
        div.className = 'checkbox-cliente';
        div.innerHTML = `<input type="checkbox" id="c-${doc.id}" value="${doc.id}"><label for="c-${doc.id}">${c.nome}</label>`;
        container.appendChild(div);
      });
    }

    document.getElementById('r-criar').addEventListener('click', async () => {
      const resp = document.getElementById('r-responsavel').value.trim();
      if (!resp) { alert('Informe o responsável'); return; }

      const selecionados = Array.from(document.querySelectorAll('#lista-clientes-rota input:checked'))
        .map(chk => ({ clienteId: chk.value, nome: chk.parentNode.textContent.trim(), status: 'pendente', devolutiva: '' }));

      if (!selecionados.length) { alert('Selecione ao menos um cliente'); return; }

      const rota = {
        data: firebase.firestore.FieldValue.serverTimestamp(),
        responsavelNome: resp,
        status: 'planejada',
        clientes: selecionados
      };
      const docRef = await db.collection('rotas').add(rota);
      gerarPdfRota(rota, docRef.id);
      alert('Rota criada e PDF gerado.');
    });

    function gerarPdfRota(rota, idRota) {
      const { jsPDF } = window.jspdf;
      const pdf = new jsPDF();
      const data = new Date().toLocaleDateString('pt-BR');

      pdf.setFontSize(16);
      pdf.text('Relatório de Rota de Visitas', 14, 20);
      pdf.setFontSize(11);
      pdf.text(`Responsável: ${rota.responsavelNome}`, 14, 30);
      pdf.text(`Data: ${data}`, 14, 37);
      pdf.text(`ID da Rota: ${idRota}`, 14, 44);
      let y = 58;
      pdf.setFontSize(12);
      pdf.text('Clientes a visitar:', 14, y);
      y += 8;
      rota.clientes.forEach((c, i) => {
        pdf.setFontSize(10);
        pdf.text(`${i+1}. ${c.nome}`, 18, y);
        y += 7;
      });
      pdf.save(`rota_${rota.responsavelNome}_${data}.pdf`);
    }

    listarClientesRota();

    /* ---------- DEVOLUTIVA ---------- */
    async function carregarRotasPendentes() {
      const sel = document.getElementById('select-rota');
      sel.innerHTML = '<option value="">Selecione</option>';
      const snap = await db.collection('rotas').where('status', '==', 'planejada').get();
      snap.forEach(doc => {
        const r = doc.data();
        const opt = document.createElement('option');
        opt.value = doc.id;
        opt.textContent = `${r.responsavelNome} – ${r.data?.toDate().toLocaleDateString('pt-BR') || ''}`;
        sel.appendChild(opt);
      });
    }

    document.getElementById('select-rota').addEventListener('change', async e => {
      const rotaId = e.target.value;
      const container = document.getElementById('clientes-devolutiva');
      container.innerHTML = '';
      if (!rotaId) { document.getElementById('finalizar-rota').style.display='none'; return; }

      const docSnap = await db.collection('rotas').doc(rotaId).get();
      const rota = docSnap.data();
      rota.clientes.forEach((c, i) => {
        const div = document.createElement('div');
        div.className = 'devolutiva-item';
        div.innerHTML = `<strong>${c.nome}</strong><textarea id="dev-${i}" rows="3" placeholder="Devolutiva..."></textarea>`;
        container.appendChild(div);
      });
      document.getElementById('finalizar-rota').style.display='inline-block';
      document.getElementById('finalizar-rota').onclick = async () => {
        const atualizados = rota.clientes.map((c, i) => ({
          ...c,
          status: 'realizada',
          devolutiva: document.getElementById(`dev-${i}`).value.trim() || 'Sem observação'
        }));
        await db.collection('rotas').doc(rotaId).update({
          clientes: atualizados,
          status: 'concluida'
        });
        // atualizar última visita dos clientes
        for (const c of atualizados) {
          await db.collection('clientes').doc(c.clienteId).update({
            ultimaVisita: firebase.firestore.FieldValue.serverTimestamp()
          });
        }
        alert('Rota finalizada e histórico atualizado.');
        container.innerHTML = '';
        document.getElementById('finalizar-rota').style.display='none';
        document.getElementById('select-rota').value = '';
        carregarRotasPendentes();
        carregarAlertas();
      };
    });

    carregarRotasPendentes();

  </script>
</body>
</html>
```
