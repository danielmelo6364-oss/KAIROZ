<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <title>Sistema de Visitas – Limpeza</title>

  <!-- ==== CSS ==== -->
  <style>
    *{margin:0;padding:0;box-sizing:border-box;font-family:"Segoe UI",Arial,sans-serif}
    body{background:#f4f5f7;color:#1f2937}
    nav{background:#1f2937;padding:16px 24px;display:flex;gap:24px}
    nav a{color:#f9fafb;text-decoration:none;font-weight:600}
    nav a:hover{color:#38bdf8}
    .container{max-width:960px;margin:32px auto;padding:0 16px}
    h1{margin-bottom:24px}
    .banner-alerta{background:#fee2e2;color:#991b1b;padding:14px 18px;border-radius:8px;margin-bottom:16px;font-weight:600}
    .sem-alertas{background:#dcfce7;color:#166534;padding:14px 18px;border-radius:8px}
    .item-alerta{background:#fff;border-left:4px solid #ef4444;padding:12px 16px;border-radius:6px;margin-bottom:10px;display:flex;flex-direction:column;gap:4px;box-shadow:0 1px 3px rgba(0,0,0,.08)}
    .nome-cliente{font-weight:700;font-size:16px}
    .dias-sem-visita{color:#b91c1c;font-size:14px}
    .responsavel{color:#6b7280;font-size:13px}
    .form-box{background:#fff;padding:20px;border-radius:8px;box-shadow:0 1px 3px rgba(0,0,0,.08);margin-bottom:24px}
    .form-box input,.form-box select,.form-box textarea{width:100%;padding:10px;margin-bottom:12px;border:1px solid #d1d5db;border-radius:6px;font-size:14px}
    button{background:#2563eb;color:#fff;border:none;padding:10px 18px;border-radius:6px;cursor:pointer;font-weight:600}
    button:hover{background:#1d4ed8}
    .card-cliente{background:#fff;padding:16px;border-radius:8px;margin-bottom:12px;box-shadow:0 1px 3px rgba(0,0,0,.08)}
    .card-cliente h3{margin-bottom:6px}
    .card-cliente .info{font-size:13px;color:#6b7280;margin-bottom:8px}
    .produtos-lista{font-size:13px;margin:8px 0;padding-left:18px}
    .acoes{display:flex;gap:8px;margin-top:8px}
    .checkbox-cliente{display:flex;align-items:center;gap:10px;background:#fff;padding:10px 14px;border-radius:6px;margin-bottom:8px}
    .devolutiva-item{background:#fff;padding:14px;border-radius:8px;margin-bottom:12px}
    .section{display:none}
    .section.active{display:block}
  </style>

  <!-- ==== Firebase SDK (CDN) ==== -->
  <script type="module">
    import { initializeApp } from "https://www.gstatic.com/firebasejs/10.12.2/firebase-app.js";
    import { getFirestore } from "https://www.gstatic.com/firebasejs/10.12.2/firebase-firestore.js";

    const firebaseConfig = {
      apiKey: "SUA_API_KEY",
      authDomain: "SEU_PROJETO.firebaseapp.com",
      projectId: "SEU_PROJETO",
      storageBucket: "SEU_PROJETO.appspot.com",
      messagingSenderId: "SEU_SENDER_ID",
      appId: "SEU_APP_ID"
    };

    const app = initializeApp(firebaseConfig);
    export const db = getFirestore(app);
  </script>

  <!-- ==== jsPDF (para gerar PDF) ==== -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
</head>

<body>
  <nav>
    <a href="#" data-section="dashboard">Dashboard</a>
    <a href="#" data-section="clientes">Clientes</a>
    <a href="#" data-section="rota">Montar Rota</a>
    <a href="#" data-section="devolutiva">Devolutiva</a>
  </nav>

  <div class="container">

    <!-- ==================== DASHBOARD ==================== -->
    <section id="dashboard" class="section active">
      <h1>Painel de Visitas</h1>
      <div id="alertas-container">Carregando alertas...</div>
    </section>

    <!-- ==================== CLIENTES ==================== -->
    <section id="clientes" class="section">
      <h1>Clientes</h1>

      <div class="form-box">
        <h3>Cadastrar novo cliente</h3>
        <input type="text" id="input-nome" placeholder="Nome do cliente">
        <input type="text" id="input-responsavel" placeholder="Nome do responsável (vendedor)">
        <button id="btn-cadastrar">Cadastrar Cliente</button>
      </div>

      <div id="lista-clientes">Carregando clientes...</div>
    </section>

    <!-- ==================== MONTAR ROTA ==================== -->
    <section id="rota" class="section">
      <h1>Montar Rota de Visitas</h1>

      <div class="form-box">
        <input type="text" id="input-responsavel-rota" placeholder="Nome do vendedor responsável">
      </div>

      <div id="lista-clientes-rota">Carregando clientes...</div>

      <button id="btn-gerar-rota" style="margin-top:16px;">Criar Rota e Gerar PDF</button>
    </section>

    <!-- ==================== DEVOLUTIVA ==================== -->
    <section id="devolutiva" class="section">
      <h1>Registrar Devolutiva da Rota</h1>

      <div class="form-box">
        <label for="select-rota">Selecione a rota:</label>
        <select id="select-rota"></select>
      </div>

      <div id="clientes-devolutiva"></div>

      <button id="btn-finalizar-rota" style="margin-top:16px;display:none;">
        Finalizar Rota e Salvar Devolutivas
      </button>
    </section>

  </div>

  <!-- ==== LÓGICA DO SISTEMA (JS) ==== -->
  <script type="module">
    import { db } from "./firebase-config.js";
    import {
      collection, addDoc, doc, updateDoc, arrayUnion, Timestamp,
      getDocs, query, orderBy, where, getDoc
    } from "https://www.gstatic.com/firebasejs/10.12.2/firebase-firestore.js";

    const { jsPDF } = window.jspdf;

    /* ---------- Navegação ---------- */
    document.querySelectorAll('nav a').forEach(a => {
      a.addEventListener('click', e => {
        e.preventDefault();
        const target = a.dataset.section;
        document.querySelectorAll('.section').forEach(s => s.classList.remove('active'));
        document.getElementById(target).classList.add('active');
        // Carrega dados específicos quando a aba é aberta
        if (target === 'dashboard') loadDashboard();
        if (target === 'clientes') loadClientes();
        if (target === 'rota') loadClientesRota();
        if (target === 'devolutiva') loadRotasPendentes();
      });
    });

    /* ---------- DASHBOARD ---------- */
    const DIAS_LIMITE = 30;
    async function loadDashboard() {
      const container = document.getElementById('alertas-container');
      container.innerHTML = 'Carregando alertas...';
      const clientesRef = collection(db, "clientes");
      const snapshot = await getDocs(clientesRef);
      const hoje = new Date();
      const atrasados = [];

      snapshot.forEach(docSnap => {
        const c = docSnap.data();
        if (!c.ultimaVisita) {
          atrasados.push({ id: docSnap.id, ...c, diasSemVisita: null });
          return;
        }
        const diff = Math.floor((hoje - c.ultimaVisita.toDate()) / (1000*60*60*24));
        if (diff > DIAS_LIMITE) {
          atrasados.push({
            id: docSnap.id,
            nome: c.nome,
            responsavelNome: c.responsavelNome,
            diasSemVisita: diff
          });
        }
      });

      if (atrasados.length === 0) {
        container.innerHTML = '<p class="sem-alertas">Nenhum cliente atrasado. Base em dia!</p>';
        return;
      }

      const banner = document.createElement('div');
      banner.className = 'banner-alerta';
      banner.innerHTML = `⚠️ <strong>${atrasados.length}</strong> cliente(s) sem visita há mais de 30 dias`;
      container.innerHTML = '';
      container.appendChild(banner);

      atrasados.forEach(c => {
        const item = document.createElement('div');
        item.className = 'item-alerta';
        item.innerHTML = `
          <span class="nome-cliente">${c.nome}</span>
          <span class="dias-sem-visita">${c.diasSemVisita ?? 'Nunca visitado'} dias sem visita</span>
          <span class="responsavel">Responsável: ${c.responsavelNome || 'Não atribuído'}</span>
        `;
        container.appendChild(item);
      });
    }

    /* ---------- CLIENTES ---------- */
    async function loadClientes() {
      const lista = document.getElementById('lista-clientes');
      lista.innerHTML = 'Carregando...';
      const q = query(collection(db, "clientes"), orderBy("nome"));
      const snap = await getDocs(q);
      if (snap.empty) {
        lista.innerHTML = '<p>Nenhum cliente cadastrado.</p>';
        return;
      }
      lista.innerHTML = '';
      snap.forEach(docSnap => {
        const c = docSnap.data();
        const ultima = c.ultimaVisita ? c.ultimaVisita.toDate().toLocaleDateString('pt-BR') : 'Nunca';
        const card = document.createElement('div');
        card.className = 'card-cliente';
        card.innerHTML = `
          <h3>${c.nome}</h3>
          <div class="info">Responsável: ${c.responsavelNome} | Última visita: ${ultima}</div>
          ${c.produtosComprados?.length ? `<ul class="produtos-lista">${c.produtosComprados.map(p=>`<li>${p.produto} (Qtd: ${p.quantidade})</li>`).join('')}</ul>` : ''}
          <div class="acoes">
            <button onclick="window.registrarProdutoUI('${docSnap.id}')">+ Produto</button>
            <button onclick="window.atualizarVisitaUI('${docSnap.id}')">Registrar Visita</button>
          </div>
        `;
        lista.appendChild(card);
      });
    }

    async function cadastrarCliente() {
      const nome = document.getElementById('input-nome').value.trim();
      const resp = document.getElementById('input-responsavel').value.trim();
      if (!nome) { alert('Nome do cliente é obrigatório'); return; }
      await addDoc(collection(db, "clientes"), {
        nome,
        responsavelNome: resp || 'Não atribuído',
        ultimaVisita: null,
        produtosComprados: [],
        criadoEm: Timestamp.now()
      });
      document.getElementById('input-nome').value = '';
      document.getElementById('input-responsavel').value = '';
      loadClientes();
    }

    async function registrarProduto(clienteId) {
      const produto = prompt('Nome do produto comprado:');
      if (!produto) return;
      const quantidade = parseInt(prompt('Quantidade:', '1')) || 1;
